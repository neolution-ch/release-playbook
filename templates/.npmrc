# Routes the @neolution-ch scope to GitHub Packages (private / restricted).
#
# IMPORTANT: this file takes precedence over `registry-url` in the release
# workflow and over NODE_AUTH_TOKEN's target. If you publish to PUBLIC npm
# instead, remove this line (or replace it with `registry=https://registry.npmjs.org`),
# otherwise publishing will silently go to GitHub Packages. See the "Publishing to
# public npm" section of docs/CHANGESETS.md.
@neolution-ch:registry=https://npm.pkg.github.com
